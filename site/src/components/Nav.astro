---
import { links } from "../data/facts";
const items = [
  ["#story", "Story"],
  ["#walkthrough", "How it works"],
  ["#architecture", "Architecture"],
  ["#decisions", "Decisions"],
  ["#results", "Results"],
  ["#lessons", "Lessons"],
];
---
<header class="nav" data-nav>
  <div class="nav-inner">
    <a href="#top" class="brand" aria-label="Helio, back to top">
      <span class="brand-mark" aria-hidden="true"><i></i></span>
      <span>Helio</span>
    </a>
    <nav aria-label="Sections">
      <ul>
        {items.map(([href, label]) => (
          <li><a href={href} data-navlink>{label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="nav-cta">
      <a class="nav-gh" href={links.repo} target="_blank" rel="noopener" aria-label="Source on GitHub">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
      </a>
      <a class="nav-demo" href={links.demo} target="_blank" rel="noopener">Live demo</a>
    </div>
  </div>
  <div class="nav-progress" aria-hidden="true"><span data-progress></span></div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition: background 0.5s var(--ease), border-color 0.5s, backdrop-filter 0.5s;
    border-bottom: 1px solid transparent;
  }
  .nav.scrolled {
    background: rgba(7, 8, 11, 0.62);
    backdrop-filter: saturate(160%) blur(18px);
    -webkit-backdrop-filter: saturate(160%) blur(18px);
    border-bottom-color: var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    max-width: var(--max);
    height: 64px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; letter-spacing: -0.02em; }
  .brand-mark {
    position: relative;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: radial-gradient(circle, #000 46%, transparent 48%), conic-gradient(from 0deg, #ffd08a, #ff8a3d, #ff4f7b, #9b6bff, #ffd08a);
    box-shadow: 0 0 18px rgba(255, 140, 70, 0.55);
  }
  nav { margin-left: auto; }
  ul { display: flex; gap: 2px; margin: 0; padding: 0; list-style: none; }
  ul a {
    display: block;
    padding: 7px 12px;
    border-radius: 999px;
    color: var(--text-2);
    font-size: 14px;
    transition: color 0.25s, background 0.25s;
  }
  ul a:hover { color: var(--text); }
  ul a.active { color: var(--text); background: rgba(255, 255, 255, 0.07); }
  .nav-cta { display: flex; align-items: center; gap: 8px; }
  .nav-gh {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--text-2);
    transition: color 0.25s, background 0.25s;
  }
  .nav-gh:hover { color: var(--text); background: rgba(255, 255, 255, 0.07); }
  .nav-demo {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--text);
    color: #0b0b0d;
    font-size: 14px;
    font-weight: 500;
    transition: transform 0.3s var(--ease);
  }
  .nav-demo:hover { transform: scale(1.04); }
  .nav-progress { position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; }
  .nav-progress span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--corona);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }
  @media (max-width: 880px) {
    nav { display: none; }
    .nav-cta { margin-left: auto; }
  }
</style>
