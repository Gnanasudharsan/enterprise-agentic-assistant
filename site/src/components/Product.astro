---
const shots = [
  { src: "/media/answer.webp", alt: "A cited answer about the September onboarding slowdown with two query-result charts", cap: "Cited answers with live charts", sub: "Click any [S#] or [T#] to open the exact passage or the SQL behind a number." },
  { src: "/media/trace.webp", alt: "The execution trace: plan, parallel steps on a timeline, model calls and token count", cap: "A trace for every run", sub: "The plan, a waterfall of parallel steps, model calls, and the run's cost." },
  { src: "/media/approval.webp", alt: "A drafted tracker issue waiting for approval with approve, edit, and reject buttons", cap: "Actions wait for you", sub: "Approve, edit, or reject. Approvals are bound to the exact arguments." },
];
---
<section class="section product" id="product">
  <div class="wrap">
    <span class="eyebrow reveal">The product</span>
    <h2 class="h2 reveal" style="--d:1">Built to be <span class="serif glow-text">checked,</span> not just believed.</h2>
    <p class="lede reveal" style="--d:2">A real recording of the deployed app. The agents plan, query, cite, and stream the answer, with nothing staged.</p>

    <figure class="stage reveal" style="--d:2">
      <div class="stage-glow" aria-hidden="true"></div>
      <div class="device">
        <video data-video src="/media/demo.mp4" poster="/media/demo-poster.webp" muted loop playsinline preload="none" aria-label="Screen recording: asking Helio a cross-source question and receiving a cited answer with a chart"></video>
      </div>
    </figure>

    <div class="shots">
      {shots.map((s, i) => (
        <figure class="shot reveal" style={`--d:${i}`}>
          <div class="shot-img"><img src={s.src} alt={s.alt} loading="lazy" decoding="async" width="1600" height="1000" /></div>
          <figcaption><b>{s.cap}</b><span>{s.sub}</span></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .stage { position: relative; margin: 64px 0 0; }
  .stage-glow {
    position: absolute;
    inset: 8% 10% -6%;
    z-index: -1;
    background: radial-gradient(50% 50% at 50% 60%, rgba(255, 138, 61, 0.35), rgba(155, 107, 255, 0.18) 45%, transparent 75%);
    filter: blur(60px);
  }
  .device {
    padding: 10px;
    border: 1px solid var(--line-2);
    border-radius: 26px;
    background: linear-gradient(180deg, #17191f, #0d0e12);
    box-shadow: 0 80px 160px -60px rgba(0, 0, 0, 0.9);
  }
  .device video { width: 100%; aspect-ratio: 16 / 10; border-radius: 17px; background: #fff; object-fit: cover; }
  .shots { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 40px; }
  .shot { margin: 0; }
  .shot-img { overflow: hidden; border: 1px solid var(--line); border-radius: 16px; background: #fff; }
  .shot-img img { width: 100%; height: auto; transition: transform 1.2s var(--ease); }
  .shot:hover img { transform: scale(1.04); }
  figcaption { display: grid; gap: 4px; margin-top: 16px; }
  figcaption b { font-weight: 500; letter-spacing: -0.015em; }
  figcaption span { color: var(--muted); font-size: 14.5px; }
  @media (max-width: 880px) { .shots { grid-template-columns: 1fr; } }
</style>
