---
import { headline, links } from "../data/facts";
const words = ["The", "AI", "research", "assistant", "that"];
---
<section class="hero" id="top">
  <canvas class="stars" data-stars aria-hidden="true"></canvas>

  <div class="wrap hero-copy">
    <span class="eyebrow reveal">Case study · Built October 29–31, 2026</span>
    <h1 class="display words" data-words>
      {words.map((w, i) => (<><span class="w"><span style={`--i:${i}`}>{w}</span></span>{" "}</>))}
      <span class="w"><span style="--i:5" class="serif glow-text">shows its work.</span></span>
    </h1>
    <p class="lede reveal" style="--d:4">
      Helio answers questions that need company documents <em>and</em> company data, cites every
      claim it makes, and never takes an action without a person's approval. Built end to end in
      three days, then measured like a product.
    </p>
    <div class="hero-actions reveal" style="--d:5">
      <a class="btn btn-primary" href="#story">
        Read the story
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a class="btn btn-ghost" href={links.demo} target="_blank" rel="noopener">
        Try the live demo
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M8 7h9v9"/></svg>
      </a>
    </div>
    <p class="access reveal" style="--d:6">The live demo spends real model credits, so it asks for an access code. Ask the author for one.</p>
  </div>

  <div class="eclipse" data-eclipse aria-hidden="true">
    <div class="corona c1"></div>
    <div class="corona c2"></div>
    <div class="ring"></div>
    <div class="disc"></div>
    <div class="bead"></div>
  </div>

  <div class="wrap">
    <dl class="stats">
      {headline.map((s, i) => (
        <div class="stat reveal" style={`--d:${i}`}>
          <dt class="stat-value">
            {s.prefix}<span data-count={s.value} data-decimals={s.decimals ?? 0}>{s.value}</span>{s.suffix}
          </dt>
          <dd>
            <span class="stat-label">{s.label}</span>
            <span class="stat-note">{s.note}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    padding: 150px 0 72px;
    overflow: hidden;
    isolation: isolate;
  }
  .stars { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; }
  .hero-copy { position: relative; z-index: 2; text-align: center; }
  .hero .display { max-width: 980px; margin-left: auto; margin-right: auto; }
  .hero .lede { margin-left: auto; margin-right: auto; }
  .hero .lede em { color: var(--text); font-style: normal; }
  .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 36px; }
  .access { margin: 16px 0 0; color: var(--muted); font-size: 13px; }

  /* The eclipse: a black disc with a turning corona and a "diamond ring" bead. */
  .eclipse {
    position: relative;
    z-index: 0;
    width: min(560px, 82vw);
    aspect-ratio: 1;
    margin: -10px auto -150px;
    transform: translate3d(var(--px, 0), var(--py, 0), 0);
    transition: transform 1.2s var(--ease);
  }
  .disc {
    position: absolute;
    inset: 22%;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #121318, #050506 70%);
    box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.9);
  }
  .ring {
    position: absolute;
    inset: 21.4%;
    border-radius: 50%;
    background: conic-gradient(from 210deg, rgba(255, 220, 160, 0.95), rgba(255, 120, 60, 0.6) 20%, rgba(255, 79, 123, 0.35) 45%, rgba(155, 107, 255, 0.4) 70%, rgba(255, 220, 160, 0.95));
    filter: blur(1.5px);
    animation: spin 26s linear infinite;
  }
  .corona {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 0deg, transparent 0deg, rgba(255, 170, 80, 0.55) 40deg, transparent 90deg, rgba(255, 79, 123, 0.4) 160deg, transparent 220deg, rgba(155, 107, 255, 0.4) 280deg, transparent 330deg);
    mask: radial-gradient(circle, transparent 27%, #000 31%, transparent 68%);
    -webkit-mask: radial-gradient(circle, transparent 27%, #000 31%, transparent 68%);
    filter: blur(22px);
    animation: spin 48s linear infinite;
  }
  .c2 { inset: -12%; opacity: 0.55; filter: blur(40px); animation-duration: 70s; animation-direction: reverse; }
  .bead {
    position: absolute;
    top: 22.5%;
    left: 30%;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #fff6e8;
    box-shadow: 0 0 18px 6px rgba(255, 220, 170, 0.85), 0 0 60px 18px rgba(255, 150, 80, 0.45);
    animation: twinkle 5s ease-in-out infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes twinkle { 50% { opacity: 0.55; transform: scale(0.8); } }

  .stats {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--glass);
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
  }
  .stat { padding: 26px 26px 24px; }
  .stat + .stat { border-left: 1px solid var(--line); }
  .stat-value {
    font-size: clamp(34px, 3.6vw, 46px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stat dd { margin: 12px 0 0; display: grid; gap: 2px; }
  .stat-label { color: var(--text); font-size: 15px; letter-spacing: -0.01em; }
  .stat-note { color: var(--muted); font-size: 13px; }

  @media (max-width: 880px) {
    .hero { padding-top: 120px; }
    .eclipse { margin-bottom: -110px; }
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stat:nth-child(3) { border-left: none; }
    .stat:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 420px) {
    .stat { padding: 20px 16px; }
  }
</style>
