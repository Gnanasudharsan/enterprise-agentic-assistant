# Copy to .env and fill in values. Never commit .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# --- LLM (OpenAI-compatible) ---
# "auto" (default): use the real model if LLM_API_KEY or OPENAI_API_KEY is set, else "fake".
# "fake": offline demo answers, no network. "openai": require a key.
# Any OpenAI-compatible endpoint works via LLM_BASE_URL (e.g. Gemini's OpenAI-compatible API).
LLM_PROVIDER=auto
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# --- PostgreSQL + pgvector ---
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change-me
POSTGRES_DB=assistant
# Host/port for running the backend outside Docker against the compose database.
# (Inside compose, the backend uses db:5432 automatically.)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DB_HOST_PORT=5433
# Read-only role used by the Data Agent (Phase 3)
POSTGRES_READONLY_USER=assistant_ro
POSTGRES_READONLY_PASSWORD=change-me-too

# --- Observability (optional) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-agentic-assistant
