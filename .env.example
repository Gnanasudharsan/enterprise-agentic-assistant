# Copy to .env and fill in values. Never commit .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# --- LLM (OpenAI-compatible) ---
# "fake" runs without an API key (deterministic answers, no network).
# Set to "openai" and fill LLM_API_KEY to use a real model. Any OpenAI-compatible
# endpoint works via LLM_BASE_URL (e.g. Gemini's OpenAI-compatible API).
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- PostgreSQL + pgvector ---
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change-me
POSTGRES_DB=assistant
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Read-only role used by the Data Agent (Phase 3)
POSTGRES_READONLY_USER=assistant_ro
POSTGRES_READONLY_PASSWORD=change-me-too

# --- Observability (optional) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-agentic-assistant
