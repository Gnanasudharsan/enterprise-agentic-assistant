# Copy to .env and fill in values. Never commit .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# --- LLM (OpenAI-compatible) ---
# "auto" (default): use the real model if LLM_API_KEY or OPENAI_API_KEY is set, else "fake".
# "fake": offline demo answers, no network. "openai": require a key.
# Any OpenAI-compatible endpoint works via LLM_BASE_URL (e.g. Gemini's OpenAI-compatible API).
LLM_PROVIDER=auto
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# --- Retrieval (RAG) ---
# "auto": OpenAI embeddings when a key is set, else the offline hashing embedder.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
RETRIEVAL_TOP_K=6
# "llm" adds a reranking call per question (better ordering, ~+1 s).
RERANKER=none
# Access groups of the demo user (JSON list) until authentication lands.
USER_GROUPS=["all-employees"]
# Hosts answers may link to (JSON list). Images are always removed and other links keep
# only their text, so injected content cannot exfiltrate data through a URL.
ANSWER_LINK_HOSTS=[]

# --- Deployment (Phase 6) ---
# A public demo spends model credits. These bound it; all are off when unset/0.
# ACCESS_CODE=choose-a-code
RATE_LIMIT_REQUESTS=0
RATE_LIMIT_WINDOW_SECONDS=600
DAILY_TOKEN_BUDGET=0
# Proxies in front of the app that append to X-Forwarded-For (Cloud Run: 1).
FORWARDED_HOPS=0
# LOG_FORMAT=json

# --- Observability (Phase 5) ---
# "gcp" exports to Google Cloud Trace; "otlp" sends OpenTelemetry traces to OTEL_EXPORTER_OTLP_ENDPOINT; with Docker Compose,
# `TRACING=otlp docker compose --profile tracing up` starts Jaeger (http://localhost:16686).
TRACING=none
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# LangSmith traces of the LangGraph runs (optional):
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=

# --- PostgreSQL + pgvector ---
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change-me
POSTGRES_DB=assistant
# Host/port for running the backend outside Docker against the compose database.
# (Inside compose, the backend uses db:5432 automatically.)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DB_HOST_PORT=5433

# --- Agents (Phase 3) ---
# Agent SQL runs read-only as the analytics_reader role (created by the migrations).
SQL_TIMEOUT_MS=5000
SQL_MAX_ROWS=200
AGENT_MAX_PLAN_STEPS=4
AGENT_MAX_SQL_ATTEMPTS=3
# "postgres" checkpoints each graph step so failed runs can resume; "memory" for demos.
AGENT_CHECKPOINTER=postgres

# --- Actions (Phase 4) ---
# Agents can draft tracker issues; nothing is created until a human approves it.
ACTIONS_ENABLED=true
# "local": built-in SQLite tracker. "github": GitHub Issues for GITHUB_REPO, using a
# fine-grained token scoped to that repository with only "Issues: read and write".
TRACKER_BACKEND=local
GITHUB_REPO=
GITHUB_TOKEN=
# Which access groups may use each tool (JSON). Unlisted tools are denied.
ACTION_PERMISSIONS={"create_issue": ["all-employees"], "search_issues": ["all-employees"]}

# --- Observability (optional) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-agentic-assistant
